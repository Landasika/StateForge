  "GET /me" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "DELETE /users/v1/{username}" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "PUT /users/v1/{username}/email" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "PUT /users/v1/{username}/email" -> "User.email=*" [label="produces"];
  "PUT /users/v1/{username}/email" -> "User.email=*" [label="produces"];
  "PUT /users/v1/{username}/password" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "PUT /users/v1/{username}/password" -> "User.password=*" [label="produces"];
  "PUT /users/v1/{username}/password" -> "User.password=*" [label="produces"];
  "POST /books/v1" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "GET /books/v1/{book_title}" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
}