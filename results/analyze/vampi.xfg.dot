digraph XFG {
  rankdir=LR;
  node [fontname="Helvetica"];
  "stateforge.targets.vampi.config.custom_problem_handler::e0" [shape=circle];
  "stateforge.targets.vampi.config.custom_problem_handler::b1" [shape=rect];
  "flask.jsonify" [shape=rect, style=filled, fillcolor=gray90];
  "<builtin>.getattr" [shape=rect, style=filled, fillcolor=gray90];
  "stateforge.targets.vampi.config.custom_problem_handler::e0" -> "stateforge.targets.vampi.config.custom_problem_handler::b1";
  "stateforge.targets.vampi.config.custom_problem_handler::b1" -> "stateforge.targets.vampi.config.custom_problem_handler::t2";
  "stateforge.targets.vampi.config.custom_problem_handler::b1" -> "flask.jsonify" [color=gray, style=dotted];
  "stateforge.targets.vampi.config.custom_problem_handler::b1" -> "<builtin>.getattr" [color=gray, style=dotted];
}