digraph XFG {
  rankdir=LR;
  node [fontname="Helvetica"];
  "fastapi_demo.app.read_order::e0" [shape=circle];
  "fastapi_demo.app.pay_order::e0" [shape=circle];
  "fastapi_demo.app.pay_order::b1" [shape=rect];
  "fastapi_demo.app.pay_order::b2" [shape=diamond];
  "fastapi_demo.app.pay_order::b3" [shape=rect];
  "GET /orders/{oid}" [shape=box, style=bold];
  "POST /orders/{oid}/pay" [shape=box, style=bold];
  "fastapi_demo.app.read_order::e0" -> "fastapi_demo.app.read_order::t1";
  "fastapi_demo.app.pay_order::e0" -> "fastapi_demo.app.pay_order::b1";
  "fastapi_demo.app.pay_order::b1" -> "fastapi_demo.app.pay_order::b2";
  "fastapi_demo.app.pay_order::b2" -> "fastapi_demo.app.pay_order::b3" [label="T"];
  "fastapi_demo.app.pay_order::b2" -> "fastapi_demo.app.pay_order::t4" [label="F"];
  "fastapi_demo.app.pay_order::b3" -> "fastapi_demo.app.pay_order::t4";
  "GET /orders/{oid}" -> "fastapi_demo.app.read_order::e0" [style=bold];
  "POST /orders/{oid}/pay" -> "fastapi_demo.app.pay_order::e0" [style=bold];
}