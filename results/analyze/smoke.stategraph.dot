digraph SSTG {
  rankdir=LR;
  node [fontname="Helvetica"];
  "GET /" [shape=box];
  "POST /auth/register" [shape=box];
  "User.role=user" [shape=ellipse, style=bold, color=red];
  "POST /auth/login" [shape=box];
  "Session.authed_as=<authed>" [shape=ellipse, style=bold, color=red];
  "GET /auth/me" [shape=box];
  "POST /orders" [shape=box];
  "Coupon.used=True" [shape=ellipse, style=bold, color=red];
  "Order.status=CREATED" [shape=ellipse, style=bold, color=red];
  "Order.paid_amount=0" [shape=ellipse, style=bold, color=red];
  "Coupon.used=1" [shape=ellipse, style=bold, color=red];
  "GET /orders/<int:oid>" [shape=box];
  "POST /orders/<int:oid>/pay" [shape=box];
  "POST /orders/<int:oid>/ship" [shape=box];
  "Order.status=PAID" [shape=ellipse, style=bold, color=red];
  "Order.status=SHIPPED" [shape=ellipse, style=bold, color=red];
  "POST /orders/<int:oid>/cancel" [shape=box];
  "Order.status=CANCELLED" [shape=ellipse, style=bold, color=red];
  "GET /coupons/<code>" [shape=box];
  "POST /admin/users/<int:uid>/role" [shape=box];
  "User.role=admin" [shape=ellipse, style=bold, color=red];
  "POST /auth/register" -> "User.role=user" [label="produces"];
  "User.role=user" -> "User.role=admin" [style=dotted, color=green, label="legal"];
  "POST /auth/login" -> "Session.authed_as=<authed>" [label="produces"];
  "GET /auth/me" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "POST /orders" -> "Coupon.used=True" [style=dashed, label="requires"];
  "POST /orders" -> "Order.status=CREATED" [label="produces"];
  "POST /orders" -> "Order.paid_amount=0" [label="produces"];
  "POST /orders" -> "Coupon.used=1" [label="produces"];
  "Coupon.used=True" -> "Coupon.used=1" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=CREATED" -> "Order.status=PAID" [style=dotted, color=green, label="legal"];
  "Order.status=CREATED" -> "Order.status=SHIPPED" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=CREATED" -> "Order.status=CANCELLED" [style=dotted, color=green, label="legal"];
  "Coupon.used=1" -> "Coupon.used=True" [style=dotted, color=red, label="ILLEGAL"];
  "POST /orders/<int:oid>/ship" -> "Order.status=PAID" [style=dashed, label="requires"];
  "POST /orders/<int:oid>/ship" -> "Order.status=SHIPPED" [label="produces"];
  "Order.status=PAID" -> "Order.status=CREATED" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=PAID" -> "Order.status=SHIPPED" [style=dotted, color=green, label="legal"];
  "Order.status=PAID" -> "Order.status=CANCELLED" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=SHIPPED" -> "Order.status=CREATED" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=SHIPPED" -> "Order.status=PAID" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=SHIPPED" -> "Order.status=CANCELLED" [style=dotted, color=red, label="ILLEGAL"];
  "POST /orders/<int:oid>/cancel" -> "Order.status=CANCELLED" [label="produces"];
  "Order.status=CANCELLED" -> "Order.status=CREATED" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=CANCELLED" -> "Order.status=PAID" [style=dotted, color=red, label="ILLEGAL"];
  "Order.status=CANCELLED" -> "Order.status=SHIPPED" [style=dotted, color=red, label="ILLEGAL"];
  "POST /admin/users/<int:uid>/role" -> "User.role=admin" [style=dashed, label="requires"];
  "POST /admin/users/<int:uid>/role" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "User.role=admin" -> "User.role=user" [style=dotted, color=red, label="ILLEGAL"];
}