  "PUT /users/v1/{username}/email" -> "user.email=*" [label="produces"];
  "PUT /users/v1/{username}/password" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "PUT /users/v1/{username}/password" -> "user.password=*" [label="produces"];
  "GET /books/v1" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "POST /books/v1" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "POST /books/v1" -> "Book.book_title=*" [label="produces"];
