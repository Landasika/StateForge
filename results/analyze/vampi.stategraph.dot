  "POST /users/v1/register" -> "User.password=*" [label="produces"];
  "POST /users/v1/register" -> "User.email=*" [label="produces"];
  "POST /users/v1/register" -> "User.admin=*" [label="produces"];
  "POST /users/v1/login" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "GET /me" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
  "GET /users/v1/{username}" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
