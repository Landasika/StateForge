  "GET /books/v1/{book_title}" [shape=box];
  "GET /createdb" -> "Response.mimetype=application/json" [label="produces"];
  "GET /" -> "Response.mimetype=application/json" [label="produces"];
  "GET /users/v1" -> "Session.authed_as=<authed>" [style=dashed, label="requires"];
