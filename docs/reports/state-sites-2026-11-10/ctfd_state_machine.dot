digraph "CTFd observed state machine" {
  rankdir=LR;
  node [fontname="Helvetica", shape=ellipse];
  "∅";
  "{_permanent,hash,id,nonce}";
  "{nonce}";
  "∅" -> "{nonce}" [label="GET /", color=green];
  "{nonce}" -> "{_permanent,hash,id,nonce}" [label="POST /login (~nonce)"];
  "{_permanent,hash,id,nonce}" -> "∅" [label="GET /logout"];
  "∅" -> "{nonce}" [label="GET /challenges", color=green];
}