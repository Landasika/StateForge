digraph Coverage {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  subgraph cluster_legend { label="legend"; style=dashed;
    L1 [label="covered", shape=box, style=filled, fillcolor="palegreen"];
    L2 [label="not covered", shape=box, color="gray", fontcolor="gray"];
    L3 [label="session access", shape=box, color="darkorange", penwidth=2.5];
    L4 [label="dynamic edge", shape=plaintext, fontcolor="blue"];
  }
  "app/main/routes.py::before_request::17-17::entry::1" [shape=circle, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::17-17::entry::1"];
  "app/main/routes.py::before_request::18-18::branch::1" [shape=diamond, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::18-18::branch::1"];
  "app/main/routes.py::before_request::19-21::block::1" [shape=rect, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::19-21::block::1"];
  "app/main/routes.py::before_request::22-22::block::1" [shape=rect, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::22-22::block::1"];
  "app/main/routes.py::before_request::17-17::exit::1" [shape=doublecircle, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::17-17::exit::1"];
  "app/main/routes.py::before_request::22-22::callsite::1" [shape=point, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::22-22::callsite::1"];
  "app/main/routes.py::before_request::22-22::returnsite::1" [shape=point, color="gray", fontcolor="gray", label="app/main/routes.py::before_request::22-22::returnsite::1"];
  "app/main/routes.py::before_request::17-17::entry::1" -> "app/main/routes.py::before_request::18-18::branch::1";
  "app/main/routes.py::before_request::18-18::branch::1" -> "app/main/routes.py::before_request::19-21::block::1";
  "app/main/routes.py::before_request::19-21::block::1" -> "app/main/routes.py::before_request::22-22::block::1";
  "app/main/routes.py::before_request::18-18::branch::1" -> "app/main/routes.py::before_request::22-22::block::1";
  "app/main/routes.py::before_request::22-22::block::1" -> "app/main/routes.py::before_request::22-22::callsite::1";
  "app/main/routes.py::before_request::22-22::returnsite::1" -> "app/main/routes.py::before_request::17-17::exit::1";
}