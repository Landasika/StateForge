digraph Coverage {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  subgraph cluster_legend { label="legend"; style=dashed;
    L1 [label="covered", shape=box, style=filled, fillcolor="palegreen"];
    L2 [label="not covered", shape=box, color="gray", fontcolor="gray"];
    L3 [label="session access", shape=box, color="darkorange", penwidth=2.5];
    L4 [label="dynamic edge", shape=plaintext, fontcolor="blue"];
  }
  "hc/front/context_processors.py::branding::7-7::entry::1" [shape=circle, style=filled, fillcolor="palegreen", label="hc/front/context_processors.py::branding::7-7::entry::1\n hits=11"];
  "hc/front/context_processors.py::branding::8-8::terminal::1" [shape=box, style=filled, fillcolor="palegreen", label="hc/front/context_processors.py::branding::8-8::terminal::1\n hits=11"];
  "hc/front/context_processors.py::branding::7-7::exit::1" [shape=doublecircle, style=filled, fillcolor="palegreen", label="hc/front/context_processors.py::branding::7-7::exit::1\n hits=11"];
  "hc/front/context_processors.py::branding::7-7::entry::1" -> "hc/front/context_processors.py::branding::8-8::terminal::1";
  "hc/front/context_processors.py::branding::8-8::terminal::1" -> "hc/front/context_processors.py::branding::7-7::exit::1";
}