digraph Coverage {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  subgraph cluster_legend { label="legend"; style=dashed;
    L1 [label="covered", shape=box, style=filled, fillcolor="palegreen"];
    L2 [label="not covered", shape=box, color="gray", fontcolor="gray"];
    L3 [label="session access", shape=box, color="darkorange", penwidth=2.5];
    L4 [label="dynamic edge", shape=plaintext, fontcolor="blue"];
    L1 -> L2 -> L3 -> L4 [style=invis]; }
  "hc/front/views.py::checks::235-235::branch::1" [shape=diamond, color="darkorange", penwidth=2.5, style=filled, fillcolor="palegreen", label="hc/front/views.py::checks::235-235::branch::1\nhits=1"];
  "hc/front/views.py::checks::236-236::block::1" [shape=rect, color="darkorange", penwidth=2.5, style=filled, fillcolor="palegreen", label="hc/front/views.py::checks::236-236::block::1\nhits=1"];
  "hc/front/views.py::checks::238-253::block::1" [shape=rect, style=filled, fillcolor="palegreen", label="hc/front/views.py::checks::238-253::block::1\nhits=1"];
  "hc/front/views.py::checks::235-235::branch::1" -> "hc/front/views.py::checks::236-236::block::1";
  "hc/front/views.py::checks::236-236::block::1" -> "hc/front/views.py::checks::238-253::block::1";
  "hc/front/views.py::checks::235-235::branch::1" -> "hc/front/views.py::checks::238-253::block::1";
}