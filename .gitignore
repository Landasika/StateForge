# 只追踪 stateforge/ + 必要配置文件,其余全部忽略

# 顾问反馈压缩包
*.tar.gz
*.tar
*.zip

# ANOTA 解释器(~GB 级)
anota/

# 外部克隆(第三方仓库)
external/

# 实验结果(大文件/二进制)
results/
exp/results/

# fuzz 产物
corpus/
crash-*
*.db
*.sqlite3
nohup.out

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# 运行时缓存
stateforge/**/cache/
stateforge/**/llm/cache/

# 例外:P0 冻结——vulnshop 语义标注缓存随仓分发。
# analyzer 语义通道"缓存优先,无缓存+无 key → 全 irrelevant";缓存缺位时
# fresh-clone 会丢 Session.authed_as 等标注 → 10 用例失败。缓存内容为
# LLM 标注 JSON(label/relate,无机密),sha256 键,同码同夹具必命中。
!stateforge/solving/llm/cache/
!stateforge/solving/llm/cache/*.json

# 文档 / 笔记 / 论文(非代码)
notes/
papers/
plans/
design.md
*.md.tmp

# make artifact 产物(R10:清单为构建产物,不入库)
artifact-manifest.sha256

# 临时
*.swp
*~
.DS_Store

# 例外:README 等必要配置保留(不忽略)
!README.md
!pyproject.toml
!pytest.ini
!LICENSE
!Makefile
!ci.sh
!ARTIFACT.md
